            "group": "additionalRemote",
            "issue": "DEXTO-2500",
            "reason": "A Cloud project deploy publishes executable code and can bind a Dexto key that acts as the project, so it stays a CLI or /v1 action; MCP clients deploy an uploaded package as themselves with dexto_function_deploy.",
            "commands": ["cloud functions deploy"],
            "closesWhen": [
                {
                    "tool": "dexto_function_deploy",
                    "inputs": ["cloudProjectId", "provider"]
                }
            ]
        },
