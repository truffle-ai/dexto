            "group": "additionalRemote",
            "issue": "DEXTO-2500",
            "reason": "Starting a deletion irreversibly erases an end user's or an agent's sessions, automations and versions, so it stays a deliberate CLI or /v1 action; MCP clients list and read deletions.",
            "commands": ["cloud data-deletions create"],
            "closesWhen": [
