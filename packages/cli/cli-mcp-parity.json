    "exceptions": [
        {
            "name": "cloud-fetch",
            "group": "additionalRemote",
            "issue": "DEXTO-2500",
            "reason": "Metered /v1/fetch has no web_fetch capability in the account MCP catalog.",
            "commands": ["cloud fetch"],
            "closesWhen": [
                {
                    "tool": "dexto_cloud_fetch",
                    "inputs": []
                }
            ]
        },
        {
            "name": "cloud-api",
            "group": "additionalRemote",
            "issue": "DEXTO-2500",
            "reason": "Arbitrary project-key /v1 dispatch has no equivalent MCP dispatcher.",
            "commands": ["cloud api"],
            "closesWhen": [
                {
                    "tool": "dexto_cloud_api",
                    "inputs": []
                }
            ]
        },
        {
            "name": "cloud-automations-rotate-secret",
